@page "/"
@rendermode InteractiveServer
@inject IptvLibraryService Library
@inject IJSRuntime JS

<PageTitle>TV Local — C# Blazor IPTV</PageTitle>

<div class="app-shell @(_playerSizeMode == "expanded" && _activeChannel is not null ? "expanded-player" : "")" style="@ThemeInlineStyle">
    @if (!(_playerSizeMode == "expanded" && _activeChannel is not null))
    {
    <aside class="sidebar">
        <div class="brand">
            <img src="images/tv-local-logo.png" alt="TV Local" class="brand-logo" />
            <div>
                <h1>TV Local</h1>
                <span>ASP.NET Core Blazor</span>
            </div>
        </div>

        <button class="btn" @onclick='() => OpenModal("m3u_url")'>+ Adicionar Lista / EPG</button>
        <button class="btn btn-secondary" @onclick="OpenMultiStreamAsync">⊞ Multi-Tela (2 / 4 Telas)</button>
        <button class="btn btn-secondary" @onclick="OpenSettingsModal">⚙ Configurações e Cores</button>

        <div>
            <div class="section-label">Navegação</div>
            @foreach (var (id, label) in NavItems)
            {
                <button class="nav-btn @(_section == id ? "active" : "")"
                        @onclick="() => SelectSection(id)">
                    <span>@label</span>
                </button>
            }
        </div>

        <div>
            <div class="section-label">Categorias</div>
            @foreach (var cat in Categories)
            {
                <button class="cat-btn @(_selectedCategory == cat.Name ? "active" : "")"
                        @onclick="() => _selectedCategory = cat.Name">
                    <span class="truncate">@cat.Name</span>
                    <span>@cat.Count</span>
                </button>
            }
        </div>
    </aside>
    }

    <main class="main-content">
        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <div class="source-item" style="border: 1px solid rgba(59,130,246,0.4);">
                <span>@_statusMessage</span>
                <button class="btn btn-secondary btn-sm" @onclick="() => _statusMessage = null">Fechar</button>
            </div>
        }

        @if (Library.Channels.Count == 0)
        {
            <div class="welcome-hero">
                <h2>Bem-vindo ao TV Local (C# Blazor)</h2>
                <p class="muted" style="line-height: 1.5; margin-bottom: 18px;">
                    Importe uma playlist M3U/M3U8, conecte um servidor Xtream Codes ou carregue os streams públicos
                    de demonstração para testar agora mesmo.
                </p>
                <div style="display:flex; gap:10px; justify-content:center; flex-wrap:wrap;">
                    <button class="btn" @onclick="LoadDemoAsync">Testar com Lista Demo</button>
                    <button class="btn btn-secondary" @onclick='() => OpenModal("m3u_url")'>Adicionar M3U / Xtream</button>
                </div>
            </div>
        }
        else
        {
            var hideEpgForLarge = _playerSizeMode != "normal";
            var isExpanded = _playerSizeMode == "expanded" && _activeChannel is not null;
            <div class="stage-grid @(hideEpgForLarge ? "stage-full" : "")">
                <div id="blazor-player-box" class="player-shell size-@_playerSizeMode @(_hidePlayerControls ? "fs-controls-hidden" : "")">
                    <div class="player-video-wrap" @onclick="OnPlayerStageClick">
                        <video id="tvlocal-video" class="player-video" style="object-fit: @_videoFit;" controls playsinline></video>
                        @if (_hidePlayerControls)
                        {
                            <button type="button" class="player-fs-reveal-overlay" aria-label="Mostrar controles"
                                    @onclick:stopPropagation="true" @onclick="() => _hidePlayerControls = false"></button>
                        }
                    </div>
                    <div class="player-bar">
                        <div style="min-width:0; flex:1;">
                            <div style="font-weight:700;">@(_activeChannel?.Name ?? "Selecione um canal abaixo")</div>
                            <div class="muted">
                                @if (_activeChannel is not null)
                                {
                                    var guide = Library.GetGuide(_activeChannel);
                                    @(guide.Current is not null
                                        ? $"Agora: {guide.Current.Title}"
                                        : _activeChannel.Group)
                                }
                            </div>
                        </div>
                        <div style="display:flex; gap:6px; flex-wrap:wrap;">
                            @if (_activeChannel is not null && _activeChannel.Kind != StreamKind.Live)
                            {
                                <button class="btn btn-secondary btn-sm" @onclick="() => SeekByAsync(-10)">-10s</button>
                                <button class="btn btn-secondary btn-sm" @onclick="() => SeekByAsync(10)">+10s</button>
                                <button class="btn btn-secondary btn-sm" @onclick="CycleSpeedAsync">@($"{BlazorSpeeds[_speedIndex]:0.##}x")</button>
                            }
                            <button class="btn btn-secondary btn-sm" @onclick="ToggleProxyAsync">
                                @(_useProxy ? "Proxy: ON" : "Proxy: OFF")
                            </button>
                            @if (_activeChannel is not null)
                            {
                                <button class="btn btn-secondary btn-sm" @onclick="() => Library.ToggleFavoriteAsync(_activeChannel.Id)">
                                    @(Library.IsFavorite(_activeChannel.Id) ? "★ Favorito" : "☆ Favoritar")
                                </button>
                            }
                            <button class="btn btn-secondary btn-sm" @onclick="OpenMultiStreamAsync">⊞ Multi-Tela</button>
                            <button class="btn btn-secondary btn-sm" @onclick="CyclePlayerSize">
                                @(_playerSizeMode == "normal" ? "⤢ Aumentar" : _playerSizeMode == "large" ? "⤢ Expandir" : "⤡ Reduzir")
                            </button>
                            <button class="btn btn-secondary btn-sm" @onclick="ToggleVideoFit">
                                @(_videoFit == "cover" ? "⬌ Ajustar" : "⬌ Preencher")
                            </button>
                            <button class="btn btn-secondary btn-sm" title="Ocultar controles (clique na tela para exibir)"
                                    @onclick="() => _hidePlayerControls = true">👁</button>
                            <button class="btn btn-secondary btn-sm" @onclick="ToggleFullscreenAsync">⛶ Tela Cheia</button>
                        </div>
                    </div>
                </div>

                @if (!hideEpgForLarge)
                {
                <aside class="epg-panel">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <strong>Guia de Programação (EPG)</strong>
                        <button class="btn btn-secondary btn-sm" @onclick='() => OpenModal("epg")'>Importar XMLTV</button>
                    </div>
                    @if (_activeChannel is null)
                    {
                        <p class="muted">Selecione um canal para visualizar a programação.</p>
                    }
                    else
                    {
                        var upcoming = Library.GetGuide(_activeChannel).Upcoming;
                        @if (upcoming.Count == 0)
                        {
                            <p class="muted">Sem guia EPG para @_activeChannel.Name.</p>
                        }
                        else
                        {
                            @foreach (var prog in upcoming)
                            {
                                <div class="epg-item">
                                    <div class="epg-time">@prog.Start.ToLocalTime().ToString("HH:mm") – @prog.Stop.ToLocalTime().ToString("HH:mm")</div>
                                    <div class="epg-title">@prog.Title</div>
                                    @if (!string.IsNullOrEmpty(prog.Description))
                                    {
                                        <p class="epg-desc">@prog.Description</p>
                                    }
                                </div>
                            }
                        }
                    }
                </aside>
                }
            </div>

            @if (!isExpanded)
            {
            var mainFuzzy = FilteredChannelsResult;
            var filteredList = mainFuzzy.Items;
            <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap;">
                <input class="search-input" style="flex:1; min-width:220px;" placeholder="Buscar canal, filme, série ou categoria..."
                       @bind="_searchQuery" @bind:event="oninput" />
                <span class="muted" style="white-space:nowrap;">
                    @filteredList.Count itens
                    @if (!string.IsNullOrEmpty(mainFuzzy.CorrectedQuery))
                    {
                        <span> • Aproximado para "<strong>@mainFuzzy.CorrectedQuery</strong>"</span>
                    }
                </span>
            </div>

            <div class="channel-grid">
                @foreach (var ch in filteredList.Take(300))
                {
                    var isActive = _activeChannel?.Id == ch.Id;
                    var isFav = Library.IsFavorite(ch.Id);
                    var guide = Library.GetGuide(ch);
                    <div class="channel-card @(isActive ? "active" : "")" @onclick="() => PlayChannelAsync(ch)">
                        <div class="channel-thumb">
                            @if (!string.IsNullOrEmpty(ch.Logo))
                            {
                                <img src="@ch.Logo" alt="@ch.Name" loading="lazy" />
                            }
                            else
                            {
                                <span>@ch.Name[..Math.Min(2, ch.Name.Length)].ToUpperInvariant()</span>
                            }
                        </div>
                        <div style="min-width:0; flex:1;">
                            <div style="display:flex; justify-content:space-between; gap:6px;">
                                <strong class="truncate" style="font-size:13.5px;">@ch.Name</strong>
                                <button class="btn btn-secondary btn-sm" style="padding:2px 6px;"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => Library.ToggleFavoriteAsync(ch.Id)">
                                    @(isFav ? "★" : "☆")
                                </button>
                            </div>
                            <div class="muted truncate">
                                @(guide.Current is not null ? $"{guide.Current.Start.ToLocalTime():HH:mm} • {guide.Current.Title}" : ch.Group)
                            </div>
                        </div>
                    </div>
                }
            </div>
            }
        }
    </main>
</div>

@if (_modalOpen)
{
    <div class="modal-backdrop" @onclick="() => _modalOpen = false">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <h3 style="margin:0;">Adicionar Lista / Fonte IPTV</h3>
                <button class="btn btn-secondary btn-sm" @onclick="() => _modalOpen = false">Fechar</button>
            </div>

            <div class="tabs-row">
                <button class="tab-pill @(_modalTab == "m3u_url" ? "active" : "")" @onclick='() => _modalTab = "m3u_url"'>URL M3U</button>
                <button class="tab-pill @(_modalTab == "m3u_file" ? "active" : "")" @onclick='() => _modalTab = "m3u_file"'>Arquivo .M3U</button>
                <button class="tab-pill @(_modalTab == "xtream" ? "active" : "")" @onclick='() => _modalTab = "xtream"'>Xtream Codes</button>
                <button class="tab-pill @(_modalTab == "epg" ? "active" : "")" @onclick='() => _modalTab = "epg"'>EPG (XMLTV)</button>
                <button class="tab-pill @(_modalTab == "demo" ? "active" : "")" @onclick='() => _modalTab = "demo"'>Demo</button>
            </div>

            @if (!string.IsNullOrEmpty(_modalError))
            {
                <div class="error-box">@_modalError</div>
            }

            @if (_modalTab == "m3u_url")
            {
                <input class="input" placeholder="Nome da lista" @bind="_m3uName" />
                <input class="input" placeholder="https://exemplo.com/lista.m3u" @bind="_m3uUrl" />
                <button class="btn" disabled="@_isBusy" @onclick="ImportM3uUrlAsync">
                    @(_isBusy ? "Carregando..." : "Importar Lista M3U")
                </button>
            }
            else if (_modalTab == "m3u_file")
            {
                <p class="muted">Escolha um arquivo .m3u, .m3u8 ou .txt:</p>
                <InputFile OnChange="OnM3uFileSelectedAsync" accept=".m3u,.m3u8,.txt" />
            }
            else if (_modalTab == "xtream")
            {
                <input class="input" placeholder="Nome do perfil" @bind="_xtName" />
                <input class="input" placeholder="http://servidor.exemplo.com:8080" @bind="_xtServer" />
                <input class="input" placeholder="Usuário" @bind="_xtUser" />
                <input class="input" type="password" placeholder="Senha" @bind="_xtPass" />
                <button class="btn" disabled="@_isBusy" @onclick="ConnectXtreamAsync">
                    @(_isBusy ? "Conectando..." : "Conectar Xtream Codes")
                </button>
            }
            else if (_modalTab == "epg")
            {
                <input class="input" placeholder="https://exemplo.com/epg.xml" @bind="_epgUrl" />
                <button class="btn" disabled="@_isBusy" @onclick="ImportEpgUrlAsync">Carregar EPG por URL</button>
                <div class="muted" style="text-align:center;">ou selecione um arquivo XML local</div>
                <InputFile OnChange="OnEpgFileSelectedAsync" accept=".xml,.xmltv" />
            }
            else if (_modalTab == "demo")
            {
                <p class="muted">Carrega streams públicos e legais de demonstração para testar o player Blazor.</p>
                <button class="btn" @onclick="LoadDemoFromModalAsync">Carregar Lista Demo Agora</button>
            }
        </div>
    </div>
}

@if (_settingsOpen)
{
    <div class="modal-backdrop" @onclick="() => _settingsOpen = false">
        <div class="modal-card" style="max-width:620px;" @onclick:stopPropagation="true">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <h3 style="margin:0;">Configurações — TV Local</h3>
                <button class="btn btn-secondary btn-sm" @onclick="() => _settingsOpen = false">Fechar</button>
            </div>

            <div class="tabs-row">
                <button class="tab-pill @(_settingsTab == "accounts" ? "active" : "")" @onclick='() => _settingsTab = "accounts"'>Contas e Listas Salvas</button>
                <button class="tab-pill @(_settingsTab == "player" ? "active" : "")" @onclick='() => _settingsTab = "player"'>Player &amp; Tela</button>
                <button class="tab-pill @(_settingsTab == "theme" ? "active" : "")" @onclick='() => _settingsTab = "theme"'>Aparência e Cores</button>
            </div>

            @if (!string.IsNullOrEmpty(_settingsStatus))
            {
                <div class="source-item" style="border: 1px solid rgba(59,130,246,0.4);">@_settingsStatus</div>
            }

            @if (_settingsTab == "accounts")
            {
                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                    <button class="btn btn-sm" @onclick='() => { _settingsOpen = false; OpenModal("m3u_url"); }'>+ Nova Lista / Conta</button>
                </div>

                @if (Library.Sources.Count == 0)
                {
                    <p class="muted">Nenhuma conta ou lista salva ainda.</p>
                }
                else
                {
                    @foreach (var src in Library.Sources)
                    {
                        <div class="source-item">
                            <div style="min-width:0; flex:1;">
                                <div><strong>@src.Name</strong> <span class="muted">(@src.Type)</span></div>
                                <div class="muted truncate">@(src.Xtream is not null ? $"{src.Xtream.ServerUrl} • {src.Xtream.Username}" : (src.Url ?? "Lista local / Demo"))</div>
                                <div class="muted">@src.ChannelCount itens</div>
                            </div>
                            <div style="display:flex; gap:6px;">
                                <button class="btn btn-secondary btn-sm" disabled="@_isBusy" @onclick="() => StartEditSource(src)">✏ Editar</button>
                                <button class="btn btn-secondary btn-sm" disabled="@_isBusy" @onclick="() => RefreshSavedSourceAsync(src.Id)">🔄 Atualizar</button>
                                <button class="btn btn-secondary btn-sm" @onclick="() => RemoveSourceAsync(src.Id)">Remover</button>
                            </div>
                        </div>
                    }

                    @if (_editingSource is not null)
                    {
                        <div class="source-item" style="flex-direction:column; align-items:stretch; gap:8px; border:1px solid var(--accent);">
                            <strong>Editar: @_editingSource.Name</strong>
                            <input class="input" placeholder="Nome da conta" @bind="_editName" />
                            @if (_editingSource.Type == PlaylistSourceType.Xtream)
                            {
                                <input class="input" placeholder="Servidor" @bind="_editServer" />
                                <input class="input" placeholder="Usuário" @bind="_editUser" />
                                <input class="input" placeholder="Senha" @bind="_editPass" />
                            }
                            else if (_editingSource.Type == PlaylistSourceType.M3uUrl)
                            {
                                <input class="input" placeholder="URL M3U" @bind="_editUrl" />
                            }
                            <label class="muted"><input type="checkbox" @bind="_editReload" /> Recarregar canais ao salvar</label>
                            <div style="display:flex; gap:8px;">
                                <button class="btn btn-sm" disabled="@_isBusy" @onclick="SaveEditedSourceAsync">Salvar Alterações</button>
                                <button class="btn btn-secondary btn-sm" @onclick="() => _editingSource = null">Cancelar</button>
                            </div>
                        </div>
                    }
                }
            }
            else if (_settingsTab == "player")
            {
                <div class="source-item">
                    <div style="min-width:0; flex:1;">
                        <div><strong>Forçar horizontal na Tela Cheia (Celular)</strong></div>
                        <div class="muted">Ao abrir tela cheia em navegador mobile, tenta girar para paisagem ignorando a trava.</div>
                    </div>
                    <input type="checkbox" @bind="_forceLandscapeFullscreen" style="width:18px;height:18px;" />
                </div>

                <div class="section-label">Tamanho da Tela de Transmissão</div>
                <div class="tabs-row">
                    <button class="tab-pill @(_playerSizeMode == "normal" ? "active" : "")" @onclick='() => _playerSizeMode = "normal"'>Normal</button>
                    <button class="tab-pill @(_playerSizeMode == "large" ? "active" : "")" @onclick='() => _playerSizeMode = "large"'>Grande</button>
                    <button class="tab-pill @(_playerSizeMode == "expanded" ? "active" : "")" @onclick='() => _playerSizeMode = "expanded"'>Expandida (Teatro)</button>
                </div>

                <div class="section-label">Ajuste da Imagem</div>
                <div class="tabs-row">
                    <button class="tab-pill @(_videoFit == "contain" ? "active" : "")" @onclick='() => _videoFit = "contain"'>Ajustar (Original)</button>
                    <button class="tab-pill @(_videoFit == "cover" ? "active" : "")" @onclick='() => _videoFit = "cover"'>Preencher Tela</button>
                </div>
            }
            else
            {
                <div class="section-label">Temas Prontos</div>
                <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap:8px;">
                    @foreach (var preset in BlazorThemePresets)
                    {
                        <button class="btn btn-secondary btn-sm" style="text-align:left; padding:10px;"
                                @onclick="() => ApplyBlazorThemeAsync(preset)">
                            <div style="display:flex; gap:4px; margin-bottom:6px;">
                                <span style="width:14px;height:14px;border-radius:3px;background:@preset.BackgroundHex;display:inline-block;"></span>
                                <span style="width:14px;height:14px;border-radius:3px;background:@preset.SurfaceHex;display:inline-block;"></span>
                                <span style="width:14px;height:14px;border-radius:3px;background:@preset.CardHex;display:inline-block;"></span>
                                <span style="width:14px;height:14px;border-radius:3px;background:@preset.AccentHex;display:inline-block;"></span>
                            </div>
                            @preset.PresetName
                        </button>
                    }
                </div>

                <div class="section-label" style="margin-top:8px;">Cores Personalizadas</div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
                    <label class="muted">Fundo Principal <input type="color" @bind="_themeBg" class="input" style="height:38px;padding:4px;" /></label>
                    <label class="muted">Painéis <input type="color" @bind="_themeSurface" class="input" style="height:38px;padding:4px;" /></label>
                    <label class="muted">Cards <input type="color" @bind="_themeCard" class="input" style="height:38px;padding:4px;" /></label>
                    <label class="muted">Cor de Destaque <input type="color" @bind="_themeAccent" class="input" style="height:38px;padding:4px;" /></label>
                </div>

                <div style="display:flex; gap:8px; margin-top:8px;">
                    <button class="btn" @onclick="ApplyCustomBlazorThemeAsync">Aplicar e Salvar Cor</button>
                    <button class="btn btn-secondary" @onclick="ResetBlazorThemeAsync">Restaurar Cor Padrão</button>
                </div>
            }
        </div>
    </div>
}

@if (_activeSeries is not null)
{
    <div class="modal-backdrop" @onclick="() => _activeSeries = null">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <h3 style="margin:0;">@_activeSeries.Name</h3>
                <button class="btn btn-secondary btn-sm" @onclick="() => _activeSeries = null">Fechar</button>
            </div>
            @if (_seriesDetails is null)
            {
                <p class="muted">Carregando temporadas e episódios...</p>
            }
            else
            {
                <div class="tabs-row">
                    @foreach (var s in _seriesDetails.Seasons.Keys.OrderBy(x => x))
                    {
                        <button class="tab-pill @(_selectedSeason == s ? "active" : "")" @onclick="() => _selectedSeason = s">
                            Temporada @s
                        </button>
                    }
                </div>
                @if (_seriesDetails.Seasons.TryGetValue(_selectedSeason, out var episodes))
                {
                    @foreach (var ep in episodes)
                    {
                        <button class="btn btn-secondary" style="text-align:left;" @onclick="() => PlayEpisodeAsync(ep)">
                            Episódio @ep.EpisodeNumber: @ep.Title
                        </button>
                    }
                }
            }
        </div>
    </div>
}

@if (_multiOpen)
{
    <div class="modal-backdrop">
        <div id="blazor-multi-box" class="multi-modal" @onclick:stopPropagation="true">
            <div class="multi-header">
                <div style="display:flex; align-items:center; gap:10px;">
                    <strong>Multi-Tela</strong>
                    <div class="tabs-row">
                        <button class="tab-pill @(_multiLayout == "2x1" ? "active" : "")" @onclick='() => SetMultiLayoutAsync("2x1")'>2 Telas</button>
                        <button class="tab-pill @(_multiLayout == "2x2" ? "active" : "")" @onclick='() => SetMultiLayoutAsync("2x2")'>4 Telas</button>
                    </div>
                </div>
                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                    <button class="btn btn-secondary btn-sm" @onclick="() => _multiShowPicker = !_multiShowPicker">
                        @(_multiShowPicker ? "⤢ Ampliar Telas" : "☰ Mostrar Lista")
                    </button>
                    <button class="btn btn-secondary btn-sm" @onclick="ToggleMultiFullscreenAsync">⛶ Tela Cheia</button>
                    <button class="btn btn-sm" @onclick="CloseMultiStreamAsync">Voltar ao Player</button>
                </div>
            </div>

            <div class="multi-body @(_multiShowPicker ? "with-picker" : "")">
                <div class="multi-grid @(_multiLayout == "2x2" ? "grid-2x2" : "grid-2x1")">
                    @for (var i = 0; i < MultiVisibleCount; i++)
                    {
                        var slotIdx = i;
                        var slot = _multiSlots[slotIdx];
                        <div class="multi-slot @(_multiTargetSlot == slotIdx ? "selected" : "")" @onclick="() => _multiTargetSlot = slotIdx">
                            <div class="multi-slot-bar" @onclick:stopPropagation="true">
                                <button class="nav-btn" style="padding:2px 6px; flex:1;" @onclick="() => _multiTargetSlot = slotIdx">
                                    <span class="truncate">@(slotIdx + 1): @(slot.Channel?.Name ?? "Slot vazio")</span>
                                </button>
                                @if (slot.Channel is not null)
                                {
                                    <button class="btn btn-secondary btn-sm" @onclick="() => ToggleSlotPlayAsync(slotIdx)">@(slot.Playing ? "⏸" : "▶")</button>
                                    <button class="btn btn-secondary btn-sm" @onclick="() => ToggleSlotMuteAsync(slotIdx)">@(slot.Muted ? "🔇" : "🔊")</button>
                                    <button class="btn btn-secondary btn-sm" @onclick="() => SoloSlotAsync(slotIdx)">🎧</button>
                                    <button class="btn btn-secondary btn-sm" @onclick="() => ClearSlotAsync(slotIdx)">✕</button>
                                }
                            </div>
                            <video id="@($"tvlocal-multi-{slotIdx}")" class="multi-slot-video" playsinline muted="@slot.Muted"></video>
                        </div>
                    }
                </div>

                @if (_multiShowPicker)
                {
                    var multiFuzzy = MultiFilteredResult;
                    <aside class="multi-picker">
                        <div class="muted" style="color:#93c5fd;">Enviando para: <strong>Tela @(_multiTargetSlot + 1)</strong></div>
                        <select class="input" @bind="_multiCategory" aria-label="Filtrar categoria no Multi-Tela">
                            @foreach (var cat in MultiCategories)
                            {
                                <option value="@cat">@(cat == "Todas" ? "Todas as categorias" : cat)</option>
                            }
                        </select>
                        <input class="input" placeholder="Buscar canal, filme, série ou categoria..." @bind="_multiSearch" @bind:event="oninput" />
                        @if (!string.IsNullOrEmpty(multiFuzzy.CorrectedQuery))
                        {
                            <div class="fuzzy-hint">Aproximado para: <strong>@multiFuzzy.CorrectedQuery</strong></div>
                        }
                        <div class="multi-picker-list">
                            @foreach (var ch in multiFuzzy.Items.Take(150))
                            {
                                <button class="multi-picker-row" @onclick="() => AssignChannelToTargetSlotAsync(ch)">
                                    <div class="truncate"><strong>@ch.Name</strong></div>
                                    <div class="muted truncate">@ch.Group</div>
                                </button>
                            }
                        </div>
                    </aside>
                }
            </div>
        </div>
    </div>
}

@code {
    private static readonly (string Id, string Label)[] NavItems =
    [
        ("Live", "TV ao Vivo"),
        ("Vod", "Filmes (VOD)"),
        ("Series", "Séries"),
        ("Favorites", "Favoritos"),
        ("Recents", "Recentes"),
    ];

    private string _section = "Live";
    private string _selectedCategory = "Todas";
    private string _searchQuery = string.Empty;
    private Channel? _activeChannel;
    private bool _useProxy;
    private string? _statusMessage;
    private string _playerSizeMode = "normal";
    private string _videoFit = "contain";
    private bool _forceLandscapeFullscreen = true;
    private bool _hidePlayerControls;
    private int _speedIndex;
    private static readonly double[] BlazorSpeeds = [1.0, 1.25, 1.5, 2.0, 0.75];

    private sealed class BlazorMultiSlot
    {
        public Channel? Channel { get; set; }
        public bool Muted { get; set; }
        public bool Playing { get; set; }
    }

    private bool _multiOpen;
    private string _multiLayout = "2x1";
    private bool _multiShowPicker = true;
    private int _multiTargetSlot;
    private string _multiCategory = "Todas";
    private string _multiSearch = string.Empty;
    private readonly BlazorMultiSlot[] _multiSlots =
    [
        new() { Muted = false },
        new() { Muted = true },
        new() { Muted = true },
        new() { Muted = true },
    ];
    private int MultiVisibleCount => _multiLayout == "2x2" ? 4 : 2;

    private bool _modalOpen;
    private string _modalTab = "m3u_url";
    private string? _modalError;
    private bool _isBusy;

    private string _m3uName = "Minha Lista IPTV";
    private string _m3uUrl = string.Empty;
    private string _xtName = "Servidor Xtream";
    private string _xtServer = string.Empty;
    private string _xtUser = string.Empty;
    private string _xtPass = string.Empty;
    private string _epgUrl = string.Empty;

    private Channel? _activeSeries;
    private SeriesDetails? _seriesDetails;
    private int _selectedSeason = 1;

    private bool _settingsOpen;
    private string _settingsTab = "accounts";
    private string? _settingsStatus;
    private string _themeBg = "#080C14";
    private string _themeSurface = "#0F1624";
    private string _themeCard = "#151E30";
    private string _themeAccent = "#3B82F6";

    private static readonly AppThemeSettings[] BlazorThemePresets =
    [
        AppThemeSettings.Default,
        new("Esmeralda", "#07110E", "#0C1C17", "#122922", "#10B981"),
        new("Roxo", "#0C0916", "#140F24", "#1D1635", "#8B5CF6"),
        new("Rubi", "#12080B", "#1C0E13", "#29151C", "#EF4444"),
        new("Dourado", "#110D07", "#1B150C", "#281F12", "#F59E0B"),
        new("Grafite", "#0C0D10", "#14161B", "#1D2028", "#06B6D4"),
    ];

    private static string SafeHex(string? value, string fallback) =>
        !string.IsNullOrWhiteSpace(value) &&
        System.Text.RegularExpressions.Regex.IsMatch(value.Trim(), "^#[0-9A-Fa-f]{6}$")
            ? value.Trim()
            : fallback;

    private string ThemeInlineStyle =>
        $"--bg: {SafeHex(Library.Theme.BackgroundHex, "#080C14")}; --bg-elevated: {SafeHex(Library.Theme.SurfaceHex, "#0F1624")}; --bg-card: {SafeHex(Library.Theme.CardHex, "#151E30")}; --accent: {SafeHex(Library.Theme.AccentHex, "#3B82F6")}; --accent-hover: {SafeHex(Library.Theme.AccentHex, "#3B82F6")};";

    private void OpenSettingsModal()
    {
        _settingsStatus = null;
        _themeBg = Library.Theme.BackgroundHex;
        _themeSurface = Library.Theme.SurfaceHex;
        _themeCard = Library.Theme.CardHex;
        _themeAccent = Library.Theme.AccentHex;
        _settingsOpen = true;
    }

    private async Task ApplyBlazorThemeAsync(AppThemeSettings theme)
    {
        await Library.UpdateThemeAsync(theme);
        _themeBg = theme.BackgroundHex;
        _themeSurface = theme.SurfaceHex;
        _themeCard = theme.CardHex;
        _themeAccent = theme.AccentHex;
        _settingsStatus = $"Tema \"{theme.PresetName}\" salvo!";
    }

    private Task ApplyCustomBlazorThemeAsync() =>
        ApplyBlazorThemeAsync(new AppThemeSettings(
            "Personalizado",
            SafeHex(_themeBg, AppThemeSettings.Default.BackgroundHex),
            SafeHex(_themeSurface, AppThemeSettings.Default.SurfaceHex),
            SafeHex(_themeCard, AppThemeSettings.Default.CardHex),
            SafeHex(_themeAccent, AppThemeSettings.Default.AccentHex)));

    private Task ResetBlazorThemeAsync() => ApplyBlazorThemeAsync(AppThemeSettings.Default);

    private async Task RefreshSavedSourceAsync(string sourceId)
    {
        _isBusy = true;
        _settingsStatus = "Atualizando fonte...";
        try
        {
            var updated = await Library.RefreshSourceAsync(sourceId);
            _settingsStatus = $"\"{updated.Name}\" atualizado ({updated.ChannelCount} itens).";
        }
        catch (Exception ex)
        {
            _settingsStatus = $"Erro ao atualizar: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private PlaylistSource? _editingSource;
    private string _editName = string.Empty;
    private string _editUrl = string.Empty;
    private string _editServer = string.Empty;
    private string _editUser = string.Empty;
    private string _editPass = string.Empty;
    private bool _editReload = true;

    private void StartEditSource(PlaylistSource src)
    {
        _editingSource = src;
        _editName = src.Name;
        _editUrl = src.Url ?? string.Empty;
        _editServer = src.Xtream?.ServerUrl ?? string.Empty;
        _editUser = src.Xtream?.Username ?? string.Empty;
        _editPass = src.Xtream?.Password ?? string.Empty;
        _editReload = src.Type is PlaylistSourceType.Xtream or PlaylistSourceType.M3uUrl;
    }

    private async Task SaveEditedSourceAsync()
    {
        if (_editingSource is null) return;
        _isBusy = true;
        _settingsStatus = "Salvando alterações...";
        try
        {
            XtreamCredentials? xtream = _editingSource.Type == PlaylistSourceType.Xtream
                ? new XtreamCredentials(_editServer, _editUser, _editPass)
                : null;
            var updated = await Library.UpdateSourceAsync(
                _editingSource.Id,
                _editName,
                _editUrl,
                xtream,
                _editReload);
            _settingsStatus = $"\"{updated.Name}\" salvo com sucesso!";
            _editingSource = null;
        }
        catch (Exception ex)
        {
            _settingsStatus = $"Erro ao salvar: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private List<Channel> SectionChannels => _section switch
    {
        "Vod" => Library.Channels.Where(c => c.Kind == StreamKind.Vod).ToList(),
        "Series" => Library.Channels.Where(c => c.Kind == StreamKind.Series).ToList(),
        "Favorites" => Library.Channels.Where(c => Library.IsFavorite(c.Id)).ToList(),
        "Recents" => Library.Recents
            .Select(id => Library.Channels.FirstOrDefault(c => c.Id == id))
            .Where(c => c is not null)
            .Cast<Channel>()
            .ToList(),
        _ => Library.Channels.Where(c => c.Kind == StreamKind.Live).ToList(),
    };

    private List<(string Name, int Count)> Categories
    {
        get
        {
            var items = SectionChannels;
            var list = new List<(string, int)> { ("Todas", items.Count) };
            list.AddRange(items.GroupBy(c => c.Group)
                .OrderBy(g => g.Key)
                .Select(g => (g.Key, g.Count())));
            return list;
        }
    }

    private FuzzySearchResult FilteredChannelsResult
    {
        get
        {
            var pool = SectionChannels
                .Where(c => _selectedCategory == "Todas" || c.Group == _selectedCategory)
                .ToList();
            return FuzzySearchService.FilterChannels(pool, _searchQuery);
        }
    }

    private IReadOnlyList<Channel> FilteredChannels => FilteredChannelsResult.Items;

    private List<string> MultiCategories
    {
        get
        {
            var groups = Library.Channels
                .Where(c => !string.IsNullOrWhiteSpace(c.Url))
                .Select(c => string.IsNullOrWhiteSpace(c.Group) ? "Geral" : c.Group)
                .Distinct()
                .OrderBy(g => g)
                .ToList();
            return ["Todas", .. groups];
        }
    }

    private FuzzySearchResult MultiFilteredResult
    {
        get
        {
            var pool = Library.Channels
                .Where(c => !string.IsNullOrWhiteSpace(c.Url) &&
                            (_multiCategory == "Todas" ||
                             (string.IsNullOrWhiteSpace(c.Group) ? "Geral" : c.Group) == _multiCategory))
                .ToList();
            return FuzzySearchService.FilterChannels(pool, _multiSearch);
        }
    }

    private void OnPlayerStageClick()
    {
        if (_hidePlayerControls)
        {
            _hidePlayerControls = false;
        }
    }

    private void SelectSection(string id)
    {
        _section = id;
        _selectedCategory = "Todas";
    }

    private void OpenModal(string tab)
    {
        _modalTab = tab;
        _modalError = null;
        _modalOpen = true;
    }

    private async Task LoadDemoAsync()
    {
        await Library.LoadDemoAsync();
        _section = "Live";
        _selectedCategory = "Todas";
        _statusMessage = "Lista demo carregada com sucesso!";
        if (FilteredChannels.Count > 0)
        {
            await PlayChannelAsync(FilteredChannels[0]);
        }
    }

    private async Task LoadDemoFromModalAsync()
    {
        _modalOpen = false;
        await LoadDemoAsync();
    }

    private void CyclePlayerSize() => _playerSizeMode = _playerSizeMode switch
    {
        "normal" => "large",
        "large" => "expanded",
        _ => "normal",
    };

    private void ToggleVideoFit() => _videoFit = _videoFit == "contain" ? "cover" : "contain";

    private Task SeekByAsync(double deltaSeconds) =>
        JS.InvokeVoidAsync("tvLocalBlazorPlayer.seekBy", "tvlocal-video", deltaSeconds).AsTask();

    private async Task CycleSpeedAsync()
    {
        _speedIndex = (_speedIndex + 1) % BlazorSpeeds.Length;
        await JS.InvokeVoidAsync("tvLocalBlazorPlayer.setRate", "tvlocal-video", BlazorSpeeds[_speedIndex]);
    }

    private async Task OpenMultiStreamAsync()
    {
        double resumeSeconds = 0;
        if (_activeChannel is not null && _activeChannel.Kind != StreamKind.Live)
        {
            resumeSeconds = await JS.InvokeAsync<double>("tvLocalBlazorPlayer.getTime", "tvlocal-video");
        }
        await JS.InvokeVoidAsync("tvLocalBlazorPlayer.pause", "tvlocal-video");

        for (var i = 0; i < _multiSlots.Length; i++)
        {
            _multiSlots[i].Channel = null;
            _multiSlots[i].Muted = i > 0;
            _multiSlots[i].Playing = false;
        }

        if (_activeChannel is not null && !string.IsNullOrWhiteSpace(_activeChannel.Url))
        {
            _multiSlots[0].Channel = _activeChannel;
            _multiSlots[0].Muted = false;
            _multiSlots[0].Playing = true;
            _multiTargetSlot = 1;
        }
        else
        {
            _multiTargetSlot = 0;
        }

        _multiOpen = true;
        _multiCategory = "Todas";
        StateHasChanged();
        await Task.Yield();

        if (_multiSlots[0].Channel is not null)
        {
            await JS.InvokeVoidAsync(
                "tvLocalBlazorPlayer.playSlot",
                "tvlocal-multi-0",
                _multiSlots[0].Channel!.Url,
                _useProxy,
                resumeSeconds,
                false);
        }
    }

    private async Task CloseMultiStreamAsync()
    {
        var chosenIdx = _multiSlots[0].Channel is not null
            ? 0
            : Array.FindIndex(_multiSlots, s => s.Channel is not null);

        Channel? transferChannel = chosenIdx >= 0 ? _multiSlots[chosenIdx].Channel : null;
        double transferTime = 0;
        if (transferChannel is not null && transferChannel.Kind != StreamKind.Live)
        {
            transferTime = await JS.InvokeAsync<double>("tvLocalBlazorPlayer.getTime", $"tvlocal-multi-{chosenIdx}");
        }

        for (var i = 0; i < _multiSlots.Length; i++)
        {
            await JS.InvokeVoidAsync("tvLocalBlazorPlayer.stopSlot", $"tvlocal-multi-{i}");
            _multiSlots[i].Channel = null;
            _multiSlots[i].Playing = false;
        }

        _multiOpen = false;
        StateHasChanged();

        if (transferChannel is not null)
        {
            if (_activeChannel is not null &&
                _activeChannel.Id == transferChannel.Id &&
                _activeChannel.Url == transferChannel.Url)
            {
                await JS.InvokeVoidAsync("tvLocalBlazorPlayer.seekAndPlay", "tvlocal-video", transferTime);
            }
            else
            {
                await PlayChannelAsync(transferChannel, transferTime);
            }
        }
    }

    private async Task SetMultiLayoutAsync(string layout)
    {
        _multiLayout = layout;
        if (layout == "2x1")
        {
            for (var i = 2; i < _multiSlots.Length; i++)
            {
                await JS.InvokeVoidAsync("tvLocalBlazorPlayer.stopSlot", $"tvlocal-multi-{i}");
                _multiSlots[i].Channel = null;
                _multiSlots[i].Playing = false;
            }
            if (_multiTargetSlot >= 2) _multiTargetSlot = 0;
        }
    }

    private async Task AssignChannelToTargetSlotAsync(Channel ch)
    {
        var idx = Math.Clamp(_multiTargetSlot, 0, MultiVisibleCount - 1);
        _multiSlots[idx].Channel = ch;
        _multiSlots[idx].Playing = true;
        StateHasChanged();
        await Task.Yield();
        await JS.InvokeVoidAsync("tvLocalBlazorPlayer.playSlot", $"tvlocal-multi-{idx}", ch.Url, _useProxy, 0, _multiSlots[idx].Muted);

        var nextEmpty = -1;
        for (var i = 0; i < MultiVisibleCount; i++)
        {
            if (i != idx && _multiSlots[i].Channel is null) { nextEmpty = i; break; }
        }
        _multiTargetSlot = nextEmpty != -1 ? nextEmpty : (idx + 1) % MultiVisibleCount;
    }

    private async Task ToggleSlotPlayAsync(int idx)
    {
        var playing = await JS.InvokeAsync<bool>("tvLocalBlazorPlayer.togglePlaySlot", $"tvlocal-multi-{idx}");
        _multiSlots[idx].Playing = playing;
    }

    private async Task ToggleSlotMuteAsync(int idx)
    {
        _multiSlots[idx].Muted = !_multiSlots[idx].Muted;
        await JS.InvokeVoidAsync("tvLocalBlazorPlayer.setSlotMuted", $"tvlocal-multi-{idx}", _multiSlots[idx].Muted);
    }

    private async Task SoloSlotAsync(int idx)
    {
        for (var i = 0; i < MultiVisibleCount; i++)
        {
            _multiSlots[i].Muted = i != idx;
            await JS.InvokeVoidAsync("tvLocalBlazorPlayer.setSlotMuted", $"tvlocal-multi-{i}", _multiSlots[i].Muted);
        }
    }

    private async Task ClearSlotAsync(int idx)
    {
        await JS.InvokeVoidAsync("tvLocalBlazorPlayer.stopSlot", $"tvlocal-multi-{idx}");
        _multiSlots[idx].Channel = null;
        _multiSlots[idx].Playing = false;
        _multiTargetSlot = idx;
    }

    private Task ToggleMultiFullscreenAsync() =>
        JS.InvokeVoidAsync("tvLocalBlazorPlayer.toggleFullscreen", "blazor-multi-box", _forceLandscapeFullscreen).AsTask();

    private async Task PlayChannelAsync(Channel channel) => await PlayChannelAsync(channel, 0);

    private async Task PlayChannelAsync(Channel channel, double startTimeSeconds)
    {
        if (channel.Kind == StreamKind.Series && string.IsNullOrEmpty(channel.Url))
        {
            _activeSeries = channel;
            _seriesDetails = null;
            _seriesDetails = await Library.GetSeriesInfoAsync(channel);
            _selectedSeason = _seriesDetails.Seasons.Keys.OrderBy(x => x).FirstOrDefault(1);
            return;
        }

        _activeChannel = channel;
        _speedIndex = 0;
        await Library.RecordRecentAsync(channel.Id);
        await JS.InvokeVoidAsync("tvLocalBlazorPlayer.play", "tvlocal-video", channel.Url, _useProxy, startTimeSeconds);
    }

    private async Task PlayEpisodeAsync(SeriesEpisode ep)
    {
        if (_activeSeries is null) return;
        var epChannel = new Channel(
            Id: $"{_activeSeries.Id}_ep_{ep.Id}",
            Name: $"{_activeSeries.Name} • T{ep.SeasonNumber}E{ep.EpisodeNumber} — {ep.Title}",
            Url: ep.Url,
            Group: _activeSeries.Group,
            Kind: StreamKind.Series,
            SourceId: _activeSeries.SourceId,
            Logo: ep.Cover ?? _activeSeries.Logo);
        _activeSeries = null;
        await PlayChannelAsync(epChannel);
    }

    private async Task ToggleProxyAsync()
    {
        _useProxy = !_useProxy;
        if (_activeChannel is not null && !string.IsNullOrEmpty(_activeChannel.Url))
        {
            var cur = _activeChannel.Kind != StreamKind.Live
                ? await JS.InvokeAsync<double>("tvLocalBlazorPlayer.getTime", "tvlocal-video")
                : 0;
            await JS.InvokeVoidAsync("tvLocalBlazorPlayer.play", "tvlocal-video", _activeChannel.Url, _useProxy, cur);
        }
    }

    private Task ToggleFullscreenAsync() =>
        JS.InvokeVoidAsync("tvLocalBlazorPlayer.toggleFullscreen", "blazor-player-box", _forceLandscapeFullscreen).AsTask();

    private async Task ImportM3uUrlAsync()
    {
        _isBusy = true;
        _modalError = null;
        try
        {
            var src = await Library.AddM3uFromUrlAsync(_m3uName, _m3uUrl);
            _statusMessage = $"{src.ChannelCount} itens importados de \"{src.Name}\".";
            _modalOpen = false;
        }
        catch (Exception ex) { _modalError = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task OnM3uFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _isBusy = true;
        _modalError = null;
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(maxAllowedSize: 30 * 1024 * 1024));
            var content = await reader.ReadToEndAsync();
            var src = await Library.AddM3uFromContentAsync(Path.GetFileNameWithoutExtension(e.File.Name), content);
            _statusMessage = $"{src.ChannelCount} itens importados de \"{src.Name}\".";
            _modalOpen = false;
        }
        catch (Exception ex) { _modalError = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task ConnectXtreamAsync()
    {
        _isBusy = true;
        _modalError = null;
        try
        {
            var src = await Library.AddXtreamSourceAsync(_xtName, new XtreamCredentials(_xtServer, _xtUser, _xtPass));
            _statusMessage = $"Xtream \"{src.Name}\" conectado ({src.ChannelCount} itens).";
            _modalOpen = false;
        }
        catch (Exception ex) { _modalError = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task ImportEpgUrlAsync()
    {
        _isBusy = true;
        _modalError = null;
        try
        {
            var count = await Library.ImportEpgFromUrlAsync(_epgUrl);
            _statusMessage = $"EPG importado ({count} canais).";
            _modalOpen = false;
        }
        catch (Exception ex) { _modalError = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task OnEpgFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _isBusy = true;
        _modalError = null;
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024));
            var xml = await reader.ReadToEndAsync();
            var count = await Library.ImportEpgFromXmlAsync(xml);
            _statusMessage = $"EPG importado ({count} canais).";
            _modalOpen = false;
        }
        catch (Exception ex) { _modalError = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task RemoveSourceAsync(string sourceId)
    {
        await Library.RemoveSourceAsync(sourceId);
        if (_activeChannel?.SourceId == sourceId) _activeChannel = null;
    }
}
