<Window x:Class="TVLocal.Wpf.EditSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Conta / Lista"
        Icon="pack://application:,,,/Assets/tv-local.ico"
        Width="520" Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ElevatedBrush}"
        Foreground="#F1F5F9"
        KeyDown="OnWindowKeyDown">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Editar Conta / Lista Salva" FontSize="19" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock x:Name="SubtitleText" FontSize="12.5" Foreground="#94A3B8"/>
        </StackPanel>

        <StackPanel x:Name="FormPanel" Grid.Row="1">
            <TextBlock Text="Nome da conta / perfil" FontSize="12.5" Foreground="#94A3B8" Margin="0,0,0,6"/>
            <TextBox x:Name="NameBox" Margin="0,0,0,14"/>

            <!-- Campos M3U URL -->
            <StackPanel x:Name="M3uFieldsPanel" Visibility="Collapsed">
                <TextBlock Text="URL da playlist (.m3u / .m3u8)" FontSize="12.5" Foreground="#94A3B8" Margin="0,0,0,6"/>
                <TextBox x:Name="M3uUrlBox" Margin="0,0,0,14"/>
            </StackPanel>

            <!-- Campos Xtream Codes -->
            <StackPanel x:Name="XtreamFieldsPanel" Visibility="Collapsed">
                <TextBlock Text="Servidor (ex.: http://servidor:8080)" FontSize="12.5" Foreground="#94A3B8" Margin="0,0,0,6"/>
                <TextBox x:Name="XtServerBox" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Usuário" FontSize="12.5" Foreground="#94A3B8" Margin="0,0,0,6"/>
                        <TextBox x:Name="XtUserBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Senha" FontSize="12.5" Foreground="#94A3B8" Margin="0,0,0,6"/>
                        <TextBox x:Name="XtPassBox"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <CheckBox x:Name="ReloadCheckBox" Content="Recarregar canais do servidor ao salvar"
                      IsChecked="True" Foreground="#CBD5E1" FontSize="12.5" Margin="0,2,0,18"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Salvar Alterações" Style="{StaticResource PrimaryButton}"
                        Padding="16,10" Margin="0,0,10,0" Click="OnSaveClick"/>
                <Button Content="Cancelar" Padding="14,10" Click="OnCancelClick"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <ProgressBar x:Name="BusyBar" Height="5" IsIndeterminate="True" Visibility="Collapsed"
                         Background="{DynamicResource CardBrush}" Foreground="{DynamicResource AccentBrush}"
                         BorderThickness="0" Margin="0,0,0,6"/>
            <TextBlock x:Name="StatusText" Foreground="#FCA5A5" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
