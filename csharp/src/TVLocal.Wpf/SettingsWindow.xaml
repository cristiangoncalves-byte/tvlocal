<Window x:Class="TVLocal.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações — TV Local"
        Icon="pack://application:,,,/Assets/tv-local.ico"
        Width="820" Height="630"
        MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="#F1F5F9"
        KeyDown="OnWindowKeyDown">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Fechar" Padding="14,8" VerticalAlignment="Center" Click="OnCloseClick"/>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Configurações do TV Local" FontSize="21" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="Gerencie suas listas, contas salvas e personalize as cores do layout."
                           FontSize="13" Foreground="#94A3B8"/>
            </StackPanel>
        </DockPanel>

        <!-- Abas em Botões Reais (nunca cortam texto) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="AccountsTabBtn" Content="📋  Listas e Contas Salvas"
                    Style="{StaticResource PrimaryButton}" Padding="16,9" Margin="0,0,10,0"
                    Click="OnSelectAccountsTab"/>
            <Button x:Name="ThemeTabBtn" Content="🎨  Aparência e Cores"
                    Padding="16,9" Click="OnSelectThemeTab"/>
        </StackPanel>

        <!-- Conteúdo Aba 1: Listas e Contas Salvas -->
        <Grid x:Name="AccountsTabPanel" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Button Content="+ Nova Conta / Lista" Style="{StaticResource PrimaryButton}"
                        Padding="14,9" Margin="0,0,10,6" Click="OnAddNewSourceClick"/>
                <Button Content="💾 Exportar Backup (.json)" Padding="13,9" Margin="0,0,10,6" Click="OnExportBackupClick"/>
                <Button Content="📂 Importar Backup (.json)" Padding="13,9" Margin="0,0,10,6" Click="OnImportBackupClick"/>
                <Button x:Name="CheckUpdatesBtn" Content="🔄 Verificar Atualizações" Padding="13,9" Margin="0,0,0,6" Click="OnCheckUpdatesClick"/>
            </WrapPanel>

            <Border Grid.Row="1" Background="{DynamicResource ElevatedBrush}"
                    BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1"
                    CornerRadius="14" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="EmptySourcesText" Text="Nenhuma conta ou lista salva ainda."
                                   Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,28" Visibility="Collapsed"/>
                        <ItemsControl x:Name="SavedSourcesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1"
                                            CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="✏ Editar" Padding="11,7" FontSize="12" Margin="0,0,8,0"
                                                        Tag="{Binding Id}" Click="OnEditSourceClick"/>
                                                <Button Content="🔄 Atualizar" Padding="11,7" FontSize="12" Margin="0,0,8,0"
                                                        Tag="{Binding Id}" Click="OnRefreshSourceClick"/>
                                                <Button Content="🗑 Remover" Padding="11,7" FontSize="12" Foreground="#FCA5A5"
                                                        Tag="{Binding Id}" Click="OnRemoveSourceClick"/>
                                            </StackPanel>

                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14.5" VerticalAlignment="Center"/>
                                                    <Border Background="#1A263D" CornerRadius="5" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TypeLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="#93C5FD"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DetailsLine}" FontSize="12.5" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding StatsLine}" FontSize="11.5" Foreground="#64748B"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <TextBlock Grid.Row="2" Text="Suas listas, contas Xtream, favoritos, recentes e cores são salvos automaticamente no perfil local."
                       FontSize="12" Foreground="#64748B" Margin="0,10,0,0"/>
        </Grid>

        <!-- Conteúdo Aba 2: Aparência e Cores -->
        <ScrollViewer x:Name="ThemeTabPanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,4,0">
                <TextBlock Text="TEMAS PRONTOS" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" Margin="2,0,0,10"/>

                <ItemsControl x:Name="PresetsList" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="232" Margin="0,0,12,12" Padding="14,12" Cursor="Hand"
                                    HorizontalContentAlignment="Left"
                                    Tag="{Binding}" Click="OnPresetClick">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Width="20" Height="20" CornerRadius="5" Background="{Binding BgPreview}" Margin="0,0,6,0" BorderBrush="#334155" BorderThickness="1"/>
                                        <Border Width="20" Height="20" CornerRadius="5" Background="{Binding SurfacePreview}" Margin="0,0,6,0" BorderBrush="#334155" BorderThickness="1"/>
                                        <Border Width="20" Height="20" CornerRadius="5" Background="{Binding CardPreview}" Margin="0,0,6,0" BorderBrush="#334155" BorderThickness="1"/>
                                        <Border Width="20" Height="20" CornerRadius="5" Background="{Binding AccentPreview}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="{DynamicResource ElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1"
                        CornerRadius="14" Padding="18" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="CORES PERSONALIZADAS (HEX)" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Fundo Principal" FontSize="12.5" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                <DockPanel>
                                    <Border x:Name="BgSwatch" DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="8" Margin="0,0,10,0" BorderBrush="#334155" BorderThickness="1"/>
                                    <TextBox x:Name="BgHexBox" TextChanged="OnHexInputChanged"/>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Painéis (Menu / Player / EPG)" FontSize="12.5" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                <DockPanel>
                                    <Border x:Name="SurfaceSwatch" DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="8" Margin="0,0,10,0" BorderBrush="#334155" BorderThickness="1"/>
                                    <TextBox x:Name="SurfaceHexBox" TextChanged="OnHexInputChanged"/>
                                </DockPanel>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cards e Botões Secundários" FontSize="12.5" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                <DockPanel>
                                    <Border x:Name="CardSwatch" DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="8" Margin="0,0,10,0" BorderBrush="#334155" BorderThickness="1"/>
                                    <TextBox x:Name="CardHexBox" TextChanged="OnHexInputChanged"/>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cor de Destaque (Botões / Seleção)" FontSize="12.5" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                <DockPanel>
                                    <Border x:Name="AccentSwatch" DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="8" Margin="0,0,10,0" BorderBrush="#334155" BorderThickness="1"/>
                                    <TextBox x:Name="AccentHexBox" TextChanged="OnHexInputChanged"/>
                                </DockPanel>
                            </StackPanel>
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="Aplicar e Salvar Cor" Style="{StaticResource PrimaryButton}"
                                    Padding="16,9" Margin="0,0,10,0" Click="OnApplyCustomThemeClick"/>
                            <Button Content="Restaurar Cor Padrão" Padding="14,9" Click="OnResetDefaultThemeClick"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <ProgressBar x:Name="BusyBar" Height="5" IsIndeterminate="True" Visibility="Collapsed"
                         Background="{DynamicResource CardBrush}" Foreground="{DynamicResource AccentBrush}"
                         BorderThickness="0" Margin="0,0,0,6"/>
            <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="#93C5FD" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
