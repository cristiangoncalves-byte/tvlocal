<Window x:Class="TVLocal.Wpf.SeriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TVLocal.Wpf"
        Title="Detalhes da Série"
        Icon="pack://application:,,,/Assets/tv-local.ico"
        Width="860" Height="640"
        MinWidth="680" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="#F1F5F9"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <local:PosterImageConverter x:Key="PosterConverter"/>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Banner Superior da Série -->
        <Border Grid.Row="0" Background="{DynamicResource ElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1"
                CornerRadius="16" Padding="22" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Poster -->
                <Border Grid.Column="0" Width="140" Height="206" CornerRadius="10" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1" ClipToBounds="True" VerticalAlignment="Top">
                    <Grid>
                        <TextBlock Text="🎞" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                        <Image x:Name="SeriesPosterImg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>

                <!-- Infos e Ações -->
                <DockPanel Grid.Column="1" Margin="22,0,0,0">
                    <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="PlayFirstBtn" Content="▶  Assistir 1º Episódio" Style="{StaticResource PrimaryButton}"
                                Padding="16,9" Margin="0,0,10,4" IsEnabled="False" Click="OnPlayFirstClick"/>
                        <Button x:Name="FavoriteBtn" Content="☆  Minha Lista" Padding="13,9"
                                Margin="0,0,10,4" Click="OnToggleFavoriteClick"/>
                        <Button Content="Voltar" Padding="13,9" Margin="0,0,0,4" Click="OnCloseClick"/>
                    </WrapPanel>

                    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#1A263D" CornerRadius="6" Padding="8,3" Margin="0,0,8,4">
                            <TextBlock x:Name="CategoryText" FontSize="11.5" Foreground="#93C5FD"/>
                        </Border>
                        <Border x:Name="RatingBadge" Background="#2B2312" CornerRadius="6" Padding="8,3" Margin="0,0,8,4" Visibility="Collapsed">
                            <TextBlock x:Name="RatingText" FontSize="11.5" FontWeight="Bold" Foreground="#FBBF24"/>
                        </Border>
                        <Border x:Name="SeasonsCountBadge" Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1"
                                CornerRadius="6" Padding="8,3" Margin="0,0,0,4" Visibility="Collapsed">
                            <TextBlock x:Name="SeasonsCountText" FontSize="11.5" Foreground="#CBD5E1"/>
                        </Border>
                    </WrapPanel>

                    <TextBlock x:Name="SeriesTitleText" DockPanel.Dock="Top" FontSize="22" FontWeight="Bold"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="92">
                        <TextBlock x:Name="PlotText" FontSize="13" Foreground="#CBD5E1"
                                   TextWrapping="Wrap" LineHeight="19"/>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Barra de Temporadas em Pílulas -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <ProgressBar x:Name="LoadingBar" Height="5" IsIndeterminate="True" Visibility="Collapsed"
                         Background="{DynamicResource CardBrush}" Foreground="{DynamicResource AccentBrush}"
                         BorderThickness="0" Margin="0,0,0,8"/>
            <TextBlock x:Name="LoadingText" Text="Carregando temporadas e episódios..."
                       FontSize="12.5" Foreground="#93C5FD" Visibility="Collapsed" Margin="0,0,0,8"/>

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="SeasonTabs">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" Tag="{Binding SeasonNumber}"
                                    Background="{Binding BgBrush}" Foreground="{Binding TextBrush}"
                                    BorderBrush="{Binding BorderBrush}" BorderThickness="1"
                                    Padding="14,8" Margin="0,0,8,0" FontWeight="SemiBold"
                                    Click="OnSeasonTabClick"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <!-- Lista de Episódios -->
        <Border Grid.Row="2" Background="{DynamicResource ElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1"
                CornerRadius="14" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="EpisodesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1"
                                    CornerRadius="10" Padding="12" Margin="0,0,0,10"
                                    Cursor="Hand" Tag="{Binding Episode}" MouseLeftButtonUp="OnEpisodeCardClick">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail do Episódio -->
                                    <Border Grid.Column="0" Width="120" Height="70" CornerRadius="8"
                                            Background="{DynamicResource BgBrush}" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding EpBadge}" FontWeight="Bold" FontSize="14"
                                                       Foreground="#93C5FD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding ThumbUrl, Converter={StaticResource PosterConverter}, ConverterParameter=220}"
                                                   Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality"/>
                                        </Grid>
                                    </Border>

                                    <!-- Título, Duração & Sinopse -->
                                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="14"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Background="#1A263D" CornerRadius="5" Padding="7,2" Margin="10,0,0,0"
                                                    Visibility="{Binding DurationVisibility}">
                                                <TextBlock Text="{Binding DurationText}" FontSize="11" Foreground="#93C5FD"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Plot}" FontSize="12.5" Foreground="#94A3B8"
                                                   TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding PlotVisibility}"/>
                                    </StackPanel>

                                    <!-- Botões de Ação -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="▶ Assistir" Style="{StaticResource PrimaryButton}"
                                                Padding="12,7" Margin="0,0,6,0"
                                                Tag="{Binding Episode}" Click="OnPlayEpisodeBtnClick"/>
                                        <Button Content="+⊞" ToolTip="Enviar episódio para Multi-Stream"
                                                Padding="9,7" Tag="{Binding Episode}" Click="OnMultiEpisodeBtnClick"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
