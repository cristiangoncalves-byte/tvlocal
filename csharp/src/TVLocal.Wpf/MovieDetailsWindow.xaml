<Window x:Class="TVLocal.Wpf.MovieDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TVLocal.Wpf"
        Title="Detalhes do Filme"
        Width="780" Height="510"
        MinWidth="640" MinHeight="430"
        WindowStartupLocation="CenterOwner"
        Background="#080C14"
        Foreground="#F1F5F9"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <local:PosterImageConverter x:Key="PosterConverter"/>
    </Window.Resources>

    <Border Margin="18" Background="#0F1624" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="16" Padding="24">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Poster -->
            <Border Grid.Column="0" Width="220" Height="330" CornerRadius="12" Background="#111927"
                    BorderBrush="#26334D" BorderThickness="1" ClipToBounds="True" VerticalAlignment="Top">
                <Grid>
                    <TextBlock Text="🎬" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                    <Image x:Name="PosterImg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>

            <!-- Informações e Ações -->
            <DockPanel Grid.Column="1" Margin="24,0,0,0">
                <!-- Botões inferiores -->
                <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="▶  Assistir Agora" Style="{StaticResource PrimaryButton}"
                            Padding="16,10" Margin="0,0,8,6" Click="OnWatchClick"/>
                    <Button Content="⧉  Janela Própria" Padding="12,10" Margin="0,0,8,6" Click="OnWatchDetachedClick"/>
                    <Button Content="+⊞  Multi-Stream" Padding="12,10" Margin="0,0,8,6" Click="OnMultiStreamClick"/>
                    <Button x:Name="FavoriteBtn" Content="☆  Minha Lista" Padding="12,10" Margin="0,0,8,6" Click="OnToggleFavoriteClick"/>
                    <Button Content="Voltar" Padding="12,10" Margin="0,0,0,6" Click="OnCancelClick"/>
                </WrapPanel>

                <!-- Badges superiores -->
                <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Background="#1A263D" CornerRadius="6" Padding="8,3" Margin="0,0,6,4">
                        <TextBlock x:Name="CategoryText" FontSize="11.5" Foreground="#93C5FD"/>
                    </Border>
                    <Border x:Name="YearBadge" Background="#151E30" BorderBrush="#26334D" BorderThickness="1"
                            CornerRadius="6" Padding="8,3" Margin="0,0,6,4" Visibility="Collapsed">
                        <TextBlock x:Name="YearText" FontSize="11.5" Foreground="#CBD5E1"/>
                    </Border>
                    <Border x:Name="DurationBadge" Background="#151E30" BorderBrush="#26334D" BorderThickness="1"
                            CornerRadius="6" Padding="8,3" Margin="0,0,6,4" Visibility="Collapsed">
                        <TextBlock x:Name="DurationText" FontSize="11.5" Foreground="#CBD5E1"/>
                    </Border>
                    <Border x:Name="RatingBadge" Background="#2B2312" CornerRadius="6" Padding="8,3" Margin="0,0,6,4" Visibility="Collapsed">
                        <TextBlock x:Name="RatingText" FontSize="11.5" FontWeight="Bold" Foreground="#FBBF24"/>
                    </Border>
                    <Border x:Name="FormatBadge" Background="#151E30" BorderBrush="#334155" BorderThickness="1"
                            CornerRadius="6" Padding="8,3" Margin="0,0,0,4" Visibility="Collapsed">
                        <TextBlock x:Name="FormatText" FontSize="11" FontWeight="Bold" Foreground="#CBD5E1"/>
                    </Border>
                </WrapPanel>

                <!-- Título -->
                <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="22" FontWeight="Bold"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                <!-- Sinopse e Ficha Técnica -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="LoadingMetaText" Text="Buscando sinopse e ficha técnica..."
                                   FontSize="12" Foreground="#60A5FA" Margin="0,0,0,8" Visibility="Collapsed"/>

                        <TextBlock Text="SINOPSE" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="PlotText" FontSize="13.5" Foreground="#CBD5E1" TextWrapping="Wrap"
                                   LineHeight="20" Margin="0,0,0,14"/>

                        <StackPanel x:Name="DirectorRow" Visibility="Collapsed" Margin="0,0,0,6">
                            <TextBlock Text="DIREÇÃO" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DirectorText" FontSize="12.5" Foreground="#E2E8F0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel x:Name="CastRow" Visibility="Collapsed">
                            <TextBlock Text="ELENCO" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CastText" FontSize="12.5" Foreground="#E2E8F0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>
